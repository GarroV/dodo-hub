---
import Base from '../../layouts/Base.astro';
import TopBar from '../../components/TopBar.astro';
import Tile from '../../components/Tile.astro';
import Card from '../../components/Card.astro';
import Plan from '../../components/Plan.astro';
import { DEFAULT_LOCALE, LOCALES, isLocale, t, type Locale } from '../../i18n';
import { getProjects } from '../../lib/projects';
import { ROADMAP_URL } from '../../lib/roadmap-url';
import { CLIENT_KEYS, CONFIG_ELEMENT_ID, type HubConfig } from '../../scripts/config';

export function getStaticPaths() {
  return LOCALES.map((l) => ({ params: { locale: l === DEFAULT_LOCALE ? undefined : l } }));
}

const param = Astro.params.locale ?? DEFAULT_LOCALE;
if (!isLocale(param)) throw new Error(`Unknown locale: ${param}`);
const locale: Locale = param;
const d = t(locale);
const projects = await getProjects();

const config: HubConfig = {
  lang: locale,
  roadmapUrl: ROADMAP_URL,
  i18n: Object.fromEntries(CLIENT_KEYS.map((k) => [k, d[k]])) as HubConfig['i18n'],
  projects: projects.map((p) => ({ slug: p.id, name: p.data.name, swarmId: p.data.swarm_project_id })),
};
const configJson = JSON.stringify(config).replace(/</g, '\\u003c');
---

<Base locale={locale}>
  <a class="skip" href="#projects">{d.skip}</a>
  <TopBar locale={locale} />
  <main class="wrap">
    <section class="hero" aria-labelledby="hero-title">
      <h1 id="hero-title">{d.heroTitle}<br /><span>{d.heroTitleMuted}</span></h1>
      <p>{d.heroLead}</p>
    </section>

    <section id="projects" aria-labelledby="projects-title" tabindex="-1">
      <h2 id="projects-title" class="visually-hidden">{d.projectsHeading}</h2>
      <div class="grid">
        {projects.map((p) => <Tile slug={p.id} project={p.data} locale={locale} d={d} />)}
      </div>
    </section>

    <section class="section" aria-labelledby="plan-title">
      <h2 id="plan-title">{d.planHeading}</h2>
      <p class="sub">{d.planLead}</p>
      <Plan d={d} scope="all" />
    </section>

    <footer class="site">{d.footer}</footer>
  </main>

  {projects.map((p) => <Card slug={p.id} project={p.data} locale={locale} d={d} />)}

  <script type="application/json" id={CONFIG_ELEMENT_ID} is:inline set:html={configJson} />
  <script>
    import '../../scripts/hub';
  </script>
</Base>

<style>
  .hero {
    padding-block: 40px 32px;
  }
  .hero h1 {
    font-size: clamp(40px, 7vw, 64px);
    line-height: 1.05;
    letter-spacing: -0.03em;
    font-weight: 700;
    margin: 0;
    text-wrap: balance;
  }
  .hero h1 span {
    color: var(--ink-3);
  }
  .hero p {
    font-size: clamp(19px, 2.4vw, 24px);
    color: var(--ink-2);
    max-width: 32ch;
    margin: 16px 0 0;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  #projects:focus {
    outline: none;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 16px;
  }
  .section {
    margin-top: var(--space-section);
  }
  .section h2 {
    font-size: clamp(28px, 4vw, 40px);
    letter-spacing: -0.025em;
    margin: 0 0 6px;
    font-weight: 700;
  }
  .sub {
    color: var(--ink-2);
    margin: 0 0 24px;
    max-width: 60ch;
  }
</style>
